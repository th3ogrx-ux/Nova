# Copie ce fichier en ".env.local" et remplis les 3 valeurs
# (Supabase > Project Settings > API).

# Adresse de ton projet Supabase (publique, sans danger)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Clé "anon" / "publishable" (publique : protégée par les règles RLS de la base)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé SECRÈTE "service_role" : sert UNIQUEMENT côté serveur (création des
# comptes clients, script de démo). NE JAMAIS la mettre dans une variable
# commençant par NEXT_PUBLIC_, ni la partager, ni la committer.
SUPABASE_SERVICE_ROLE_KEY=
